{
  "name": "chess-clock",
  "private": true,
  "version": "0.2.0",
  "description": "Chess clock for two players",
  "author": "Thomas Carvalho",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc && tsc -p test",
    "test": "node --test \"test/**/*.test.ts\"",
